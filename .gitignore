# Monorepo-wide ignores — patterns are unanchored so they apply inside apps/*.

# dependencies
node_modules/
.pnp
.pnp.*

# testing
coverage/
test-results/
playwright-report/
.playwright/

# next.js
.next/
out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# android signing (Play Store upload key — never commit)
key.properties
*.keystore
*.jks

# android build outputs
apps/*/android/.gradle/
apps/*/android/build/
apps/*/android/app/build/
apps/*/android/capacitor-cordova-android-plugins/
apps/*/android/local.properties
